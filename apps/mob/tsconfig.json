{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react",
		"types": ["bun"]
	},
	"include": ["src", "test", "scripts"]
}
