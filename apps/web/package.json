{
	"name": "@mob/web",
	"private": true,
	"type": "module",
	"description": "usemob.app: the landing, demo and account pages, the Cloudflare Worker, and the deploy that adds /app and /docs",
	"scripts": {
		"dev": "vite --mode public",
		"build": "bun scripts/build.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p worker",
		"test": "vitest run",
		"check:site": "bun scripts/check-site.ts",
		"check:runner": "bun scripts/check-runner.ts"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.11",
		"@lobehub/icons-static-svg": "1.95.1",
		"@mob/app": "workspace:*",
		"@mob/ui": "workspace:*",
		"better-auth": "1.7.11",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261019.1",
		"@mob/docs": "workspace:*",
		"@mob/mob": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "1.4.3",
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@webgpu/types": "^0.1.74",
		"happy-dom": "^20.14.5",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.0",
		"wrangler": "4.151.2"
	}
}
