---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from './ThemeSelect.astro';
import { siteLinks } from '../../../../webapp/src/components/site/navigation';
import { calfHeadSVG } from '../../../../webapp/src/components/brand/calfHead';
import '../../../../webapp/src/components/site/header.css';
---

<div class="site-header docs-header">
	<div class="site-header-inner">
		<a href="/" class="site-brand" aria-label="Mob home">
			<span class="logo"><Fragment set:html={calfHeadSVG(" width='30' height='30' aria-hidden='true'")} /><span class="logo-word">mob</span></span>
		</a>
		<nav class="site-links" aria-label="Site">
			{siteLinks.map(link => <a href={link.href} aria-current={link.href === '/docs/' ? 'page' : undefined}>{link.label}</a>)}
		</nav>
		<div class="docs-search print:hidden"><Search /></div>
		<div class="site-theme"><ThemeSelect /></div>
		<div class="site-account">
			<a href="/app">Open Mob</a>
			<div id="site-user"><a class="site-user site-login" href="/?signin=account">Log in</a></div>
		</div>
	</div>
</div>

<script>
	import { createElement } from 'react';
	import { createRoot } from 'react-dom/client';
	import { UserMenu } from '../../../../webapp/src/landing/UserMenu';
	if (new URLSearchParams(location.search).has('search')) {
		customElements.whenDefined('site-search').then(() => document.querySelector<HTMLButtonElement>('[data-open-modal]')?.click());
	}
	const sidebar = document.querySelector('.sidebar-content');
	if (sidebar) {
		const header = document.querySelector('.docs-header .site-header-inner')!;
		const mobileNavigation = document.createElement('div');
		mobileNavigation.id = 'mobile-site-navigation';
		sidebar.prepend(mobileNavigation);
		const links = header.querySelector('.site-links')!;
		const search = header.querySelector('.docs-search')!;
		const theme = header.querySelector('.site-theme')!;
		const mobile = matchMedia('(width < 50rem)');
		// Search shortcuts must reveal the drawer before opening its nested dialog.
		search.querySelector('dialog')!.addEventListener('beforetoggle', event => {
			if ((event as ToggleEvent).newState === 'open' && mobile.matches) {
				document.getElementById('starlight__sidebar')!.showPopover();
			}
		});
		function placeNavigation() {
			if (mobile.matches) mobileNavigation.append(search, links);
			else { header.insertBefore(links, theme); header.insertBefore(search, theme); }
		}
		placeNavigation();
		mobile.addEventListener('change', placeNavigation);
	}
	createRoot(document.getElementById('site-user')!).render(createElement(UserMenu));
</script>

<style is:global>
	:root { --sl-nav-height: 72px; }
	.page > .header { padding: 0; border: 0; background: transparent; }
	.sl-menu-button {
		border: 1px solid color-mix(in srgb, var(--sl-color-white) 12%, transparent);
		border-radius: 8px;
		background: transparent;
		color: var(--sl-color-white);
		box-shadow: none;
	}
	.sl-menu-button:hover, .sl-menu-button:has(~ :popover-open) { background: color-mix(in srgb, var(--sl-color-white) 6%, transparent); }
	.sl-menu-button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
	.docs-header .site-header-inner { grid-template-columns: auto auto minmax(0, 1fr) auto auto; }
	.docs-search { min-width: 0; }
	#mobile-site-navigation { display: none; }
	.docs-search button[data-open-modal] { height: 36px; }
	@media (min-width: 50rem) {
		.sidebar-pane { inset-block-start: 0; scroll-padding-top: var(--sl-nav-height); }
		.sidebar-content { padding-top: calc(var(--sl-nav-height) + 1rem); }
	}
	@media (max-width: 900px) {
		.docs-header .site-header-inner { gap: 12px; }
		.docs-search { justify-self: end; }
		.docs-search button[data-open-modal] { width: 32px; justify-content: center; padding: 0; border: 0; background: transparent; }
		.docs-search button[data-open-modal] > :is(span, kbd) { display: none !important; }
	}
	@media (width < 50rem) {
		:root { --sl-nav-height: 64px; }
		.docs-header .site-header-inner { grid-template-columns: 1fr auto; padding: 12px 12px 12px 56px; gap: 8px; }
		.docs-header .docs-search { display: none; }
		.sl-menu-button { inset-inline: 12px auto; width: 36px; height: 36px; top: 14px; }
		.sidebar-pane { width: min(320px, 85vw); margin: 0; border-right: 1px solid var(--sl-color-gray-5); }
		.sidebar-pane::backdrop { background: #0006; top: var(--sl-nav-height); }
		#mobile-site-navigation { font-size: 14px; display: flex; flex-direction: column; gap: 16px; border-bottom: 1px solid var(--sl-color-gray-5); padding-bottom: 16px; }
		#mobile-site-navigation .site-links { display: flex; flex-direction: column; align-items: stretch; gap: 4px; }
		#mobile-site-navigation a { padding: 8px 12px; color: var(--sl-color-white); text-decoration: none; }
		#mobile-site-navigation .docs-search { display: block; width: 100%; }
		#mobile-site-navigation button[data-open-modal] { width: 100%; justify-content: start; padding: 8px 12px; border: 1px solid var(--sl-color-gray-5); }
		#mobile-site-navigation button[data-open-modal] > span { display: block !important; }
	}
</style>
