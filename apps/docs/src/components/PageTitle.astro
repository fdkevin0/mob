---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
---
<PageTitle />
<div class="article-toc lg:sl-hidden"><MobileTableOfContents /></div>
<style is:global>
	.article-toc { margin-top: 1rem; }
	.article-toc nav { position: static; border-top: 0; background: transparent; }
	.article-toc summary { padding-inline: 0; border-bottom: 0; }
	.main-frame { padding-top: var(--sl-nav-height); }
</style>
