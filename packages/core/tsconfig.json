{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["bun"]
	},
	// tools.test.ts holds a type assertion on defineTool, so it is typechecked too.
	"include": ["src", "test/tools.test.ts"]
}
