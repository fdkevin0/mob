// The public site at https://mob.fdkevin.cloud: the landing page, GitHub sign-in
// (Better Auth with Turnstile, accounts in D1) and the web UI behind it, which
// talks only to the Mob a `mob open --web` link points it at. Cloudflare Workers
// Builds deploys it from this repository with build command
// `bun install --frozen-lockfile && bun run build:web` and deploy command
// `npx wrangler d1 migrations apply DB --remote && npx wrangler deploy`.
// Secrets: BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY and GITHUB_CLIENT_SECRET.
// The Turnstile site key and GitHub client ID are public, so they are vars.
{
	"$schema": "https://unpkg.com/wrangler@4/config-schema.json",
	"name": "mob",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./webapp/dist-public",
		"binding": "ASSETS",
		"run_worker_first": ["/*", "!/assets/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mob-auth",
			"database_id": "4de3925b-83b6-4df5-87df-d0e2d764226d",
			"migrations_dir": "worker/migrations"
		}
	],
	"vars": {
		"GITHUB_CLIENT_ID": "Ov23liO90RZ7gTbMmoOJ",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFb9fVa1goMgd_NC"
	},
	"routes": [{ "pattern": "mob.fdkevin.cloud", "custom_domain": true }],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	}
}
