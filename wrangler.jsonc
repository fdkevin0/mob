// The public site at https://usemob.app: the landing page, GitHub sign-in
// (Better Auth with Turnstile, accounts in D1), the web UI behind it, which
// connects to loopback Mob or an end-to-end encrypted runner relay, and the
// documentation at /docs (apps/docs). Cloudflare Workers
// Builds deploys it from this repository with build command
// `bun install --frozen-lockfile && bun run build:web` and deploy command
// `npx wrangler d1 migrations apply DB --remote && npx wrangler deploy`.
// Secrets: BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY and GITHUB_CLIENT_SECRET.
// The Turnstile site key and GitHub client ID are public, so they are vars.
// PR builds apply migrations with wrangler.preview-migrations.jsonc before
// running `npx wrangler preview`; their auth data uses a separate D1.
{
	"$schema": "https://unpkg.com/wrangler@4/config-schema.json",
	"name": "mob",
	"account_id": "98010e731e09a77b673ba51074dfbe1c",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./webapp/dist-public",
		"binding": "ASSETS",
		"run_worker_first": ["/*", "!/assets/*", "!/og.png", "!/logo.png", "!/logo.svg", "!/docs/_astro/*", "!/docs/pagefind/*"]
	},
	"durable_objects": { "bindings": [{ "name": "RUNNERS", "class_name": "RunnerRelay" }] },
	"migrations": [{ "tag": "runner-v1", "new_sqlite_classes": ["RunnerRelay"] }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mob-auth",
			"database_id": "4de3925b-83b6-4df5-87df-d0e2d764226d",
			"migrations_dir": "worker/migrations"
		}
	],
	"vars": {
		"CLOUDFLARE_CLIENT_ID": "859294fc8bdaddc51370de0725deedf1",
		"GITHUB_CLIENT_ID": "Ov23liO90RZ7gTbMmoOJ",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFb9fVa1goMgd_NC"
	},
	"previews": {
		"vars": {
			"CLOUDFLARE_CLIENT_ID": "859294fc8bdaddc51370de0725deedf1",
			"GITHUB_CLIENT_ID": "Ov23liO90RZ7gTbMmoOJ",
			"TURNSTILE_SITE_KEY": "0x4AAAAAAFb9fVa1goMgd_NC"
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "mob-auth-preview",
				"database_id": "9ecd0ba5-6341-421c-88ce-16ff15b9047b"
			}
		],
		"observability": {
			"logs": {
				"enabled": true,
				"head_sampling_rate": 1,
				"invocation_logs": true,
				"persist": true
			},
			"traces": {
				"enabled": true,
				"head_sampling_rate": 1,
				"persist": true
			},
			"issues": {
				"enabled": true
			}
		}
	},
	"routes": [{ "pattern": "usemob.app", "custom_domain": true, "previews_enabled": true }],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	}
}
