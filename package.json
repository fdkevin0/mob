{
  "name": "mob",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Local Go assistant with Wails, AI SDK UI and Bubble Tea.",
  "dependencies": {
    "@ai-sdk/react": "4.0.130",
    "ai": "7.0.127",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.14",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "vite build --config webapp/vite.config.ts",
    "test:webapp": "tsc -p webapp && vitest run --config webapp/vitest.config.ts",
    "dev": "vite --config webapp/vite.config.ts",
    "build:cli": "bun run build && go build -o build/mob ./cmd/mob",
    "desktop": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 dev",
    "build:desktop": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 build",
    "test:go": "go test ./...",
    "test:integration": "bun scripts/check-chat.ts",
    "generate:contracts": "go run ./cmd/contracts > webapp/src/chat/contracts.ts"
  },
  "packageManager": "bun@1.4.3"
}
