{
  "name": "mob",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Local assistant with Electron, AI SDK UI and OpenTUI.",
  "workspaces": ["packages/*", "apps/*"],
  "dependencies": {
    "@ai-sdk/react": "4.0.146",
    "@better-auth/passkey": "1.7.11",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@lobehub/icons-static-svg": "1.95.1",
    "@mob/client": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "ai": "7.0.142",
    "better-auth": "1.7.11",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.28",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "4.151.2"
  },
  "scripts": {
    "build": "vite build --config webapp/vite.config.ts",
    "build:web": "vite build --config webapp/vite.config.ts --mode public && bun run --cwd apps/docs build",
    "test:webapp": "tsc -p webapp && vitest run --config webapp/vitest.config.ts",
    "test:client": "tsc -p packages/client && vitest run --config packages/client/vitest.config.ts",
    "tui:pilot": "bun run --cwd apps/tui start",
    "test:tui": "bun run --cwd apps/tui typecheck && bun run --cwd apps/tui test",
    "test:docs": "bun run --cwd apps/docs sync && bun run --cwd apps/docs test",
    "test:dsh": "bun run --cwd apps/dsh typecheck && bun run --cwd apps/dsh test",
    "dev": "vite --config webapp/vite.config.ts",
    "build:cli": "bun run build && bun apps/mob/scripts/build.ts",
    "desktop": "bun run build:cli && MOB_BINARY=$PWD/build/mob bun run --cwd apps/desktop start",
    "build:desktop": "bun run --cwd apps/desktop package",
    "test:desktop": "bun run --cwd apps/desktop typecheck && bun run --cwd apps/desktop test",
    "test:core": "bun run --cwd packages/core typecheck && bun run --cwd packages/core test && bun run --cwd apps/mob typecheck && bun run --cwd apps/mob test",
    "test:integration": "bun scripts/check-chat.ts",
    "test:runner": "tsc -p worker && bun scripts/check-runner.ts",
    "generate:configdocs": "bun run --cwd apps/mob configdocs"
  },
  "packageManager": "bun@1.4.3"
}
