{
  "name": "mob",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Local Go assistant with Wails, AI SDK UI and Bubble Tea.",
  "workspaces": ["packages/*", "apps/*"],
  "dependencies": {
    "@ai-sdk/react": "4.0.146",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@mob/client": "workspace:*",
    "ai": "7.0.142",
    "better-auth": "1.7.11",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.28",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "4.151.2"
  },
  "scripts": {
    "build": "vite build --config webapp/vite.config.ts",
    "build:web": "vite build --config webapp/vite.config.ts --mode public",
    "test:webapp": "tsc -p webapp && vitest run --config webapp/vitest.config.ts",
    "test:client": "tsc -p packages/client && vitest run --config packages/client/vitest.config.ts",
    "tui:pilot": "bun run --cwd apps/tui start",
    "test:tui": "bun run --cwd apps/tui typecheck && bun run --cwd apps/tui test",
    "test:dsh": "bun run --cwd apps/dsh typecheck && bun run --cwd apps/dsh test && go test ./internal/plugins/mcp -run TestDSHBridge",
    "dev": "vite --config webapp/vite.config.ts",
    "build:cli": "bun run build && go build -o build/mob ./cmd/mob",
    "desktop": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 dev",
    "build:desktop": "go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 build",
    "test:go": "go test ./...",
    "test:integration": "bun scripts/check-chat.ts",
    "generate:contracts": "go run ./cmd/contracts > packages/client/src/contracts.ts"
  },
  "packageManager": "bun@1.4.3"
}
